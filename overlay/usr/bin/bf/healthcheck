#!/usr/bin/nu

use bf
bf env load -x

# From https://github.com/docker-library/healthcheck/blob/master/redis/docker-healthcheck
def main [] {
    # get the host IP to ping
    let host = { ^hostname -i } | bf handle -i | match $in { $h if $h != "" => $h, _ => "127.0.0.1" }

    # pass password (if set)
    let auth = match ($env.BF_REDIS_PASS? | default "") {
        "" => {},
        $p => {REDISCLI_AUTH: $p}
    }

    # ping host
    bf write debug $"Pinging redis host ($host)."
    let args = [
        "-h"
        $host
        "ping"
    ]
    let ping = with-env $auth { { ^redis-cli ...$args } | bf handle -i }
    if $ping != "PONG" { exit 1 }
}
